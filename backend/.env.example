PORT=3001

# X Layer Testnet
RPC_URL=https://testrpc.xlayer.tech/terigon
PRIVATE_KEY=0x...

# Deployed contracts (copy from deployments.json)
MATCH_ORACLE_ADDRESS=0x679675D1b05d24b16Fa5aB8e7292A4be837291A9
CONVICTION_VAULT_ADDRESS=0xCB6Ee65db81EB7ee2ebcFc97AC64EADBd1729937

# football-data.org free tier key — https://www.football-data.org/client/register
# NEVER set FOOTBALL_API_KEY as a VITE_ variable — it must stay server-side only.
# Leave blank to use mock data (scores page shows demo fixtures).
FOOTBALL_API_KEY=

FOOTBALL_API_BASE=https://api.football-data.org/v4
WC_COMPETITION=WC
WC_SEASON=2026

# Where keeper state is persisted between restarts
STATE_FILE=./keeper-state.json

# Optional: protect POST /api/admin/sync from unauthorized callers
# Leave blank to allow unauthenticated sync triggers (dev only)
ADMIN_KEY=
