# ── Chain config ────────────────────────────────────────────────────────────────
# X Layer mainnet:  chainId=196, rpc=https://rpc.xlayer.tech
# X Layer testnet:  chainId=1952 (official docs), rpc=https://testrpc.xlayer.tech/terigon
# Some chain lists show 195 — set whichever your RPC accepts.
XLAYER_CHAIN_ID=1952
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon

# ── Deployer ────────────────────────────────────────────────────────────────────
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
TREASURY_ADDRESS=0xYOUR_TREASURY_WALLET_HERE

# ── Optional: existing addresses (leave blank to deploy fresh) ──────────────────
# If POOL_MANAGER_ADDRESS is empty, Deploy.s.sol deploys a demo MockPoolManager.
# On X Layer mainnet, paste the official Uniswap v4 PoolManager address here.
POOL_MANAGER_ADDRESS=

# ── Existing token (leave blank to deploy MockUSDC) ─────────────────────────────
MOCK_USDC_ADDRESS=

# ── Block explorer verification ─────────────────────────────────────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ── Frontend env vars (copy to frontend/.env after deployment) ──────────────────
# VITE_CHAIN_ID=1952
# VITE_RPC_URL=https://testrpc.xlayer.tech/terigon
# VITE_MOCK_USDC_ADDRESS=
# VITE_CONVICTION_VAULT_ADDRESS=
# VITE_VAR_MARKET_ADDRESS=
# VITE_MATCH_ORACLE_ADDRESS=
# VITE_CHAMPION_POOL_ADDRESS=
# VITE_STADIUM_NFT_ADDRESS=
# VITE_STADIUM_HOOK_ADDRESS=
